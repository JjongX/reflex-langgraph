# Settings for every example. Create .env with:
#   cd examples && reflex-langgraph init-env
# .env is git-ignored; never commit it. Variables set in the shell win over the file.
# Relative paths are taken from this folder.

# Gemini API key (required). Paste it yourself.
GOOGLE_API_KEY=

# --- 05_jobs_with_approval only ---------------------------------------------------------
# Keep its conversations and pending approvals across restarts:
# JOBS_EXAMPLE_DATA_DIR=data

# --- reflex-langgraph ui, run from this folder, reads only these: ----------------------
RLG_API_URL=http://localhost:8100
